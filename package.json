{
    "name": "al-additions",
    "version": "0.8.1",
    "description": "A userscript that adds extra tools to AniList, including a one-way AniList → MyAnimeList sync, a score and progress editor, airing indicators, OP/ED songs and quick links to other sites.",
    "main": "al-additions.user.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "watch": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "tsc && vite build && node -e \"require('fs').copyFileSync('dist/al-additions.user.js', 'al-additions.user.js')\"",
        "bump": "node scripts/bump.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Daiya404/AL-Additions.git"
    },
    "keywords": [],
    "author": "Daiya",
    "license": "GPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/Daiya404/AL-Additions/issues"
    },
    "homepage": "https://github.com/Daiya404/AL-Additions#readme",
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^29.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vite-plugin-monkey": "^8.1.1",
        "vitest": "^5.0.5"
    }
}
